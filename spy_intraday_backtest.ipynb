   "source": [
    "def verify_trades(data, trades, confirmations, commission=0.0035, slippage=0.001):\n",
    "    bars = data.set_index(\"timestamp\").sort_index()\n",
    "\n",
    "    def signal_at(row):\n",
    "        if row[\"close\"] > max(row[\"upper_band\"], row[\"vwap\"]):\n",
    "            return 1\n",
    "        if row[\"close\"] < min(row[\"lower_band\"], row[\"vwap\"]):\n",
    "            return -1\n",
    "        return 0\n",
    "\n",
    "    for trade in trades.itertuples(index=False):\n",
    "        entry_time = pd.Timestamp(trade.entry_time)\n",
    "        exit_time = pd.Timestamp(trade.exit_time)\n",
    "        direction = 1 if trade.direction == \"long\" else -1\n",
    "\n",
    "        # Positions must open and close within the same day.\n",
    "        assert entry_time.date() == exit_time.date()\n",
    "        assert entry_time < exit_time\n",
    "        assert trade.shares > 0\n",
    "\n",
    "        # Entry uses the opening price AFTER the completed signal bar.\n",
    "        signal_time = entry_time - pd.Timedelta(minutes=1)\n",
    "        signal_bar = bars.loc[signal_time]\n",
    "\n",
    "        assert signal_at(signal_bar) == direction\n",
    "        assert np.isclose(\n",
    "            trade.entry_price, bars.loc[entry_time, \"open\"]\n",
    "        )\n",
    "\n",
    "        # Variation requires another matching signal 30 minutes earlier.\n",
    "        if confirmations == 2:\n",
    "            previous_signal_time = signal_time - pd.Timedelta(minutes=30)\n",
    "\n",
    "            assert previous_signal_time.date() == entry_time.date()\n",
    "            assert previous_signal_time.hour * 60 + previous_signal_time.minute >= 599\n",
    "            assert signal_at(bars.loc[previous_signal_time]) == direction\n",
    "\n",
    "        # Check exit price and rule.\n",
    "        if trade.exit_reason == \"end of day\":\n",
    "            assert exit_time.hour == 16 and exit_time.minute == 0\n",
    "\n",
    "            final_bar = bars.loc[\n",
    "                exit_time - pd.Timedelta(minutes=1)\n",
    "            ]\n",
    "            assert np.isclose(trade.exit_price, final_bar[\"close\"])\n",
    "\n",
    "        else:\n",
    "            exit_signal_bar = bars.loc[\n",
    "                exit_time - pd.Timedelta(minutes=1)\n",
    "            ]\n",
    "            assert signal_at(exit_signal_bar) != direction\n",
    "            assert np.isclose(\n",
    "                trade.exit_price, bars.loc[exit_time, \"open\"]\n",
    "            )\n",
    "\n",
    "        # Check profit and costs under our ordinary assumptions.\n",
    "        expected_gross = (\n",
    "            direction * trade.shares\n",
    "            * (trade.exit_price - trade.entry_price)\n",
    "        )\n",
    "        expected_costs = 2 * trade.shares * (commission + slippage)\n",
    "\n",
    "        assert np.isclose(trade.gross_pnl, expected_gross)\n",
    "        assert np.isclose(trade.costs, expected_costs)\n",
    "        assert np.isclose(\n",
    "            trade.net_pnl, expected_gross - expected_costs\n",
    "        )\n",
    "\n",
    "    print(f\"Passed checks for {len(trades)} trades.\")\n",
    "\n",
    "\n",
    "verify_trades(train_prices, baseline_train_trades, 1)\n",
    "verify_trades(train_prices, variation_train_trades, 2)\n",
    "verify_trades(test_prices, baseline_test_trades, 1)\n",
    "verify_trades(test_prices, variation_test_trades, 2)"
   ]
  },
