   "source": [
    "def calculate_metrics(daily_results):\n",
    "    returns = daily_results[\"daily_return\"]\n",
    "    initial_value = daily_results[\"starting_equity\"].iloc[0]\n",
    "    final_value = daily_results[\"equity\"].iloc[-1]\n",
    "\n",
    "    number_of_days = len(returns)\n",
    "    daily_volatility = returns.std(ddof=1)\n",
    "\n",
    "    annual_return = (\n",
    "        (final_value / initial_value) ** (252 / number_of_days) - 1\n",
    "    )\n",
    "\n",
    "    annual_volatility = daily_volatility * np.sqrt(252)\n",
    "\n",
    "    # Assume a zero risk-free rate.\n",
    "    sharpe = (\n",
    "        returns.mean() / daily_volatility * np.sqrt(252)\n",
    "        if daily_volatility > 0\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "    # Include starting capital when calculating previous peaks.\n",
    "    equity_path = np.concatenate([\n",
    "        [initial_value],\n",
    "        daily_results[\"equity\"].to_numpy(),\n",
    "    ])\n",
    "    previous_peaks = np.maximum.accumulate(equity_path)\n",
    "    drawdowns = equity_path / previous_peaks - 1\n",
    "\n",
    "    return {\n",
    "        \"Annualized return (%)\": annual_return * 100,\n",
    "        \"Annualized volatility (%)\": annual_volatility * 100,\n",
    "        \"Sharpe ratio\": sharpe,\n",
    "        \"Maximum drawdown (%)\": -drawdowns.min() * 100,\n",
    "    }\n",
    "\n",
    "\n",
    "train_comparison = pd.DataFrame({\n",
    "    \"Baseline\": calculate_metrics(baseline_train),\n",
    "    \"Confirmation variation\": calculate_metrics(variation_train),\n",
    "}).T\n",
    "\n",
    "train_comparison[\"Completed trades\"] = [\n",
    "    len(baseline_train_trades),\n",
    "    len(variation_train_trades),\n",
    "]\n",
    "\n",
    "display(train_comparison.round(2))\n",
    "train_comparison.to_csv(\"results/train_comparison.csv\")"
   ]
  },
