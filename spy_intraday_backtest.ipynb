   "source": [
    "# Load daily prices and dividend records.\n",
    "daily_prices = pd.read_csv(\"data/SPY_daily.csv\")\n",
    "daily_prices[\"date\"] = (\n",
    "    pd.to_datetime(daily_prices[\"timestamp\"], utc=True)\n",
    "    .dt.tz_convert(\"America/New_York\")\n",
    "    .dt.date\n",
    ")\n",
    "daily_prices = daily_prices.set_index(\"date\").sort_index()\n",
    "\n",
    "dividend_records = pd.read_csv(\"data/SPY_dividends.csv\")\n",
    "dividend_records[\"date\"] = pd.to_datetime(\n",
    "    dividend_records[\"ex_dividend_date\"]\n",
    ").dt.date\n",
    "\n",
    "dividends_by_date = dividend_records.groupby(\"date\")[\"dividend\"].sum()\n",
    "\n",
    "benchmark_prices = daily_prices.loc[test_dates[0]:test_dates[-1]].copy()\n",
    "evaluation_dates = benchmark_prices.index\n",
    "\n",
    "\n",
    "def include_cash_days(result, calendar):\n",
    "    \"\"\"Include excluded sessions as zero-return cash days.\"\"\"\n",
    "    initial = result[\"starting_equity\"].iloc[0]\n",
    "\n",
    "    equity = result[\"equity\"].reindex(calendar).ffill().fillna(initial)\n",
    "    starting = equity.shift(1).fillna(initial)\n",
    "\n",
    "    return pd.DataFrame({\n",
    "        \"starting_equity\": starting,\n",
    "        \"equity\": equity,\n",
    "        \"daily_return\": equity / starting - 1,\n",
    "    })\n",
    "\n",
    "\n",
    "# Align both strategies to the same full trading calendar.\n",
    "baseline_test_aligned = include_cash_days(\n",
    "    baseline_test, evaluation_dates\n",
    ")\n",
    "variation_test_aligned = include_cash_days(\n",
    "    variation_test, evaluation_dates\n",
    ")\n",
    "\n",
    "# Buy once at the first session's open; sell at the final close.\n",
    "initial_capital = 100_000\n",
    "commission = 0.0035\n",
    "slippage = 0.001\n",
    "\n",
    "purchase_price = benchmark_prices[\"open\"].iloc[0]\n",
    "shares = int(\n",
    "    initial_capital / (purchase_price + commission + slippage)\n",
    ")\n",
    "\n",
    "cash = initial_capital - shares * (\n",
    "    purchase_price + commission + slippage\n",
    ")\n",
    "\n",
    "# Cash dividends: credited on ex-date as a simplifying assumption.\n",
    "# No entitlement to a dividend if purchased on that ex-date.\n",
    "cash_dividends = (\n",
    "    pd.Series(benchmark_prices.index, index=benchmark_prices.index)\n",
    "    .map(dividends_by_date)\n",
    "    .fillna(0)\n",
    ")\n",
    "cash_dividends.iloc[0] = 0\n",
    "\n",
    "benchmark_equity = (\n",
    "    cash\n",
    "    + shares * benchmark_prices[\"close\"]\n",
    "    + shares * cash_dividends.cumsum()\n",
    ")\n",
    "\n",
    "# Charge final liquidation costs.\n",
    "benchmark_equity.iloc[-1] -= shares * (commission + slippage)\n",
    "\n",
    "benchmark_starting = benchmark_equity.shift(1).fillna(initial_capital)\n",
    "\n",
    "buy_hold_test = pd.DataFrame({\n",
    "    \"starting_equity\": benchmark_starting,\n",
    "    \"equity\": benchmark_equity,\n",
    "    \"daily_return\": benchmark_equity / benchmark_starting - 1,\n",
    "})\n",
    "\n",
    "comparison_with_benchmark = pd.DataFrame({\n",
    "    \"Baseline\": calculate_metrics(baseline_test_aligned),\n",
    "    \"Confirmation\": calculate_metrics(variation_test_aligned),\n",
    "    \"SPY buy-and-hold\": calculate_metrics(buy_hold_test),\n",
    "}).T\n",
    "\n",
    "display(comparison_with_benchmark.round(2))\n",
    "\n",
    "comparison_with_benchmark.to_csv(\n",
    "    \"results/test_comparison_with_benchmark.csv\"\n",
    ")\n",
    "buy_hold_test.to_csv(\"results/buy_hold_test_daily.csv\")"
   ]
  },
