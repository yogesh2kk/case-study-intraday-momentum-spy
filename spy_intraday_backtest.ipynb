    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# ---------- Load the three datasets ----------\n",
    "\n",
    "minute = pd.read_csv(\"data/SPY_1min.csv\")\n",
    "daily = pd.read_csv(\"data/SPY_daily.csv\")\n",
    "dividends = pd.read_csv(\"data/SPY_dividends.csv\")\n",
    "\n",
    "for table in [minute, daily]:\n",
    "    table[\"timestamp\"] = (\n",
    "        pd.to_datetime(table[\"timestamp\"], utc=True)\n",
    "        .dt.tz_convert(\"America/New_York\")\n",
    "    )\n",
    "\n",
    "    table.sort_values(\"timestamp\", inplace=True)\n",
    "\n",
    "    if table[\"timestamp\"].duplicated().any():\n",
    "        raise ValueError(\"Duplicate timestamps found.\")\n",
    "\n",
    "    columns = [\"open\", \"high\", \"low\", \"close\", \"volume\"]\n",
    "\n",
    "    if table[columns].isna().any().any():\n",
    "        raise ValueError(\"Missing price or volume values found.\")\n",
    "\n",
    "    if (table[[\"open\", \"high\", \"low\", \"close\"]] <= 0).any().any():\n",
    "        raise ValueError(\"Non-positive prices found.\")\n",
    "\n",
    "    if (table[\"volume\"] < 0).any():\n",
    "        raise ValueError(\"Negative volume found.\")\n",
    "\n",
    "    invalid = (\n",
    "        (table[\"high\"] < table[[\"open\", \"close\", \"low\"]].max(axis=1))\n",
    "        | (table[\"low\"] > table[[\"open\", \"close\", \"high\"]].min(axis=1))\n",
    "    )\n",
    "\n",
    "    if invalid.any():\n",
    "        raise ValueError(\"Inconsistent OHLC prices found.\")\n",
    "\n",
    "minute[\"date\"] = minute[\"timestamp\"].dt.date\n",
    "minute[\"time\"] = minute[\"timestamp\"].dt.strftime(\"%H:%M\")\n",
    "daily[\"date\"] = daily[\"timestamp\"].dt.date\n",
    "\n",
    "if daily[\"date\"].duplicated().any():\n",
    "    raise ValueError(\"Multiple daily rows for one date.\")\n",
    "\n",
    "# ---------- Keep complete regular sessions ----------\n",
    "\n",
    "# Simplification: exclude early-close sessions and days with missing bars.\n",
    "# A full session contains every minute from 09:30 through 15:59.\n",
    "expected_times = set(\n",
    "    pd.date_range(\n",
    "        \"2000-01-01 09:30\",\n",
    "        \"2000-01-01 15:59\",\n",
    "        freq=\"min\",\n",
    "    ).strftime(\"%H:%M\")\n",
    ")\n",
    "\n",
    "valid_days = [\n",
    "    date\n",
    "    for date, group in minute.groupby(\"date\")\n",
    "    if len(group) == 390 and set(group[\"time\"]) == expected_times\n",
    "]\n",
    "\n",
    "excluded_days = sorted(set(minute[\"date\"]) - set(valid_days))\n",
    "\n",
    "print(\"Excluded incomplete/early-close sessions:\", len(excluded_days))\n",
    "print(excluded_days)\n",
    "\n",
    "df = minute[minute[\"date\"].isin(valid_days)].copy()\n",
    "\n",
    "# ---------- Previous close and dividend adjustment ----------\n",
    "\n",
    "# Shift the full daily dataset before mapping to retained sessions.\n",
    "# This preserves the true preceding trading day's closing price.\n",
    "daily[\"previous_close\"] = daily[\"close\"].shift(1)\n",
    "\n",
    "previous_close_map = daily.set_index(\"date\")[\"previous_close\"]\n",
    "df[\"previous_close\"] = df[\"date\"].map(previous_close_map)\n",
    "\n",
    "dividends[\"date\"] = pd.to_datetime(\n",
    "    dividends[\"ex_dividend_date\"]\n",
    ").dt.date\n",
    "\n",
    "dividend_map = dividends.groupby(\"date\")[\"dividend\"].sum()\n",
    "df[\"dividend\"] = df[\"date\"].map(dividend_map).fillna(0)\n",
    "\n",
    "df[\"adjusted_previous_close\"] = (\n",
    "    df[\"previous_close\"] - df[\"dividend\"]\n",
    ")\n",
    "\n",
    "# ---------- Today's opening price ----------\n",
    "\n",
    "df[\"day_open\"] = df.groupby(\"date\")[\"open\"].transform(\"first\")\n",
    "\n",
    "# ---------- VWAP: resets each day ----------\n",
    "\n",
    "typical_price = (df[\"high\"] + df[\"low\"] + df[\"close\"]) / 3\n",
    "\n",
    "df[\"price_times_volume\"] = typical_price * df[\"volume\"]\n",
    "\n",
    "cumulative_value = df.groupby(\"date\")[\"price_times_volume\"].cumsum()\n",
    "cumulative_volume = df.groupby(\"date\")[\"volume\"].cumsum()\n",
    "\n",
    "df[\"vwap\"] = cumulative_value / cumulative_volume.replace(0, np.nan)\n",
    "\n",
    "# ---------- Expected movement at each time ----------\n",
    "\n",
    "df[\"move_from_open\"] = abs(df[\"close\"] / df[\"day_open\"] - 1)\n",
    "\n",
    "# Rows = sessions; columns = minute of the day.\n",
    "movement_table = df.pivot(\n",
    "    index=\"date\",\n",
    "    columns=\"time\",\n",
    "    values=\"move_from_open\",\n",
    ").sort_index()\n",
    "\n",
    "# shift(1) excludes today's movement.\n",
    "# Use the preceding 14 retained complete sessions.\n",
    "sigma_table = (\n",
    "    movement_table.shift(1)\n",
    "    .rolling(window=14, min_periods=14)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "sigma_lookup = sigma_table.stack().rename(\"sigma\")\n",
    "\n",
    "df = df.join(sigma_lookup, on=[\"date\", \"time\"])\n",
    "\n",
    "# ---------- Upper and lower bands ----------\n",
    "\n",
    "upper_anchor = np.maximum(\n",
    "    df[\"day_open\"], df[\"adjusted_previous_close\"]\n",
    ")\n",
    "\n",
    "lower_anchor = np.minimum(\n",
    "    df[\"day_open\"], df[\"adjusted_previous_close\"]\n",
    ")\n",
    "\n",
    "df[\"upper_band\"] = upper_anchor * (1 + df[\"sigma\"])\n",
    "df[\"lower_band\"] = lower_anchor * (1 - df[\"sigma\"])\n",
    "\n",
    "# Keep warm-up rows; their bands will be missing.\n",
    "# The backtest will skip sessions without valid indicators.\n",
    "df.to_csv(\"data/SPY_indicators.csv\", index=False)\n",
    "\n",
    "print(\"\\nSaved: data/SPY_indicators.csv\")\n",
    "print(\"Complete sessions:\", df[\"date\"].nunique())\n",
    "print(\"Sessions with bands:\", df.loc[df[\"sigma\"].notna(), \"date\"].nunique())\n",
