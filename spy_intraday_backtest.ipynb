    "# (a) Actual period returns (not annualised)\n",
    "def total_return_pct(result):\n",
    "    return (result[\"equity\"].iloc[-1] / result[\"starting_equity\"].iloc[0] - 1) * 100\n",
    "\n",
    "period_returns = pd.Series({\n",
    "    (\"Development\", \"Baseline\"): total_return_pct(baseline_train_aligned),\n",
    "    (\"Development\", \"Confirmation\"): total_return_pct(variation_train_aligned),\n",
    "    (\"Test\", \"Baseline\"): total_return_pct(baseline_test_aligned),\n",
    "    (\"Test\", \"Confirmation\"): total_return_pct(variation_test_aligned),\n",
    "    (\"Test\", \"SPY buy-and-hold\"): total_return_pct(buy_hold_test),\n",
    "}, name=\"Actual period return (%)\")\n",
    "display(period_returns.round(2))\n",
    "\n",
    "# (b) Paired daily difference: confirmation minus baseline\n",
    "for label, base_r, conf_r in [\n",
    "    (\"Development\", baseline_train_aligned, variation_train_aligned),\n",
    "    (\"Test\", baseline_test_aligned, variation_test_aligned),\n",
    "]:\n",
    "    diff = conf_r[\"daily_return\"] - base_r[\"daily_return\"]\n",
    "    t_stat = diff.mean() / (diff.std(ddof=1) / np.sqrt(len(diff)))\n",
    "    print(f\"{label}: mean daily difference {diff.mean() * 1e4:.2f} bp, \"\n",
    "          f\"t-statistic {t_stat:.2f} (|t| < 2: not distinguishable from noise)\")\n",
    "\n",
    "# (c) EXPLORATORY sensitivity: exit at the official daily close instead of the 15:59 bar close\n",
    "official_close = daily_prices[\"close\"].to_dict()\n",
    "sens_rows = []\n",
    "for period, data, calendar in [\n",
    "    (\"Development\", train_prices, train_calendar),\n",
    "    (\"Test\", test_prices, evaluation_dates),\n",
    "]:\n",
    "    for strategy_name, confirmations in [(\"Baseline\", 1), (\"Confirmation\", 2)]:\n",
    "        for exit_label, closes in [\n",
    "            (\"15:59 bar close (as submitted)\", None),\n",
    "            (\"Official daily close (sensitivity)\", official_close),\n",
    "        ]:\n",
    "            daily_result, _ = run_backtest(\n",
    "                data, confirmation_required=confirmations, official_close=closes\n",
    "            )\n",
    "            row = calculate_metrics(include_cash_days(daily_result, calendar))\n",
    "            row.update({\n",
    "                \"Period\": period,\n",
    "                \"Strategy\": strategy_name,\n",
    "                \"End-of-day exit price\": exit_label,\n",
    "            })\n",
    "            sens_rows.append(row)\n",
    "\n",
    "exit_sensitivity = pd.DataFrame(sens_rows).set_index(\n",
    "    [\"Period\", \"Strategy\", \"End-of-day exit price\"]\n",
    ")\n",
    "display(exit_sensitivity.round(3))\n",
    "exit_sensitivity.to_csv(\"results/exploratory_exit_price_sensitivity.csv\")\n"
   ]
