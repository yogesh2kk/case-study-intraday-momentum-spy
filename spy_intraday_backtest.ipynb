      "Reusing existing raw data CSVs. No API request made.\n"
     ]
    }
   ],
   "source": [
    "import time\n",
    "from pathlib import Path\n",
    "from getpass import getpass\n",
    "from urllib.parse import urlparse\n",
    "\n",
    "import requests\n",
    "import pandas as pd\n",
    "\n",
    "RAW_FILES = [Path(\"data\") / name for name in [\"SPY_1min.csv\", \"SPY_daily.csv\", \"SPY_dividends.csv\"]]\n",
    "NEED_DOWNLOAD = not all(p.exists() for p in RAW_FILES)\n",
    "\n",
    "if NEED_DOWNLOAD and \"api_key\" not in globals():\n",
    "    api_key = getpass(\"Paste your Massive API key: \")\n",
    "\n",
    "BASE_URL = \"https://api.massive.com\"\n",
    "START = \"2024-11-01\"\n",
    "END = \"2026-09-30\"\n",
    "\n",
    "Path(\"data\").mkdir(exist_ok=True)\n",
    "\n",
    "session = requests.Session()\n",
    "if NEED_DOWNLOAD:\n",
    "    session.headers[\"Authorization\"] = f\"Bearer {api_key}\"\n",
    "\n",
    "last_request_time = 0\n",
    "\n",
    "\n",
    "def fetch_pages(url, params=None):\n",
    "    \"\"\"Download every page, with rate limiting and error handling.\"\"\"\n",
    "    global last_request_time\n",
    "    rows = []\n",
    "\n",
    "    while url:\n",
    "        # Only send credentials to the official API host.\n",
    "        if urlparse(url).netloc != \"api.massive.com\":\n",
    "            raise ValueError(\"Unexpected API host.\")\n",
    "\n",
    "        for attempt in range(4):\n",
    "            wait = max(0, 13 - (time.monotonic() - last_request_time))\n",
    "            time.sleep(wait)\n",
    "\n",
    "            last_request_time = time.monotonic()\n",
    "            response = session.get(url, params=params, timeout=90)\n",
    "\n",
    "            if response.status_code == 429 or response.status_code >= 500:\n",
    "                time.sleep(60 if response.status_code == 429 else 5)\n",
    "                continue\n",
    "\n",
    "            if response.status_code != 200:\n",
    "                raise RuntimeError(\n",
    "                    f\"Download failed: HTTP {response.status_code}. \"\n",
    "                    \"Check your account permissions, dates, and API key.\"\n",
    "                )\n",
    "\n",
    "            break\n",
    "        else:\n",
    "            raise RuntimeError(\"Repeated API errors. Try again later.\")\n",
    "\n",
    "        payload = response.json()\n",
    "        rows.extend(payload.get(\"results\", []))\n",
    "\n",
    "        url = payload.get(\"next_url\")\n",
    "        params = None  # The next-page URL already contains its parameters.\n",
    "\n",
    "    return rows\n",
    "\n",
    "\n",
    "def download_prices(timespan):\n",
    "    \"\"\"Download minute or daily prices in monthly chunks.\"\"\"\n",
    "    all_rows = []\n",
    "\n",
    "    for month_start in pd.date_range(START, END, freq=\"MS\"):\n",
    "        month_end = min(\n",
    "            month_start + pd.offsets.MonthEnd(0),\n",
    "            pd.Timestamp(END),\n",
    "        )\n",
    "\n",
    "        start_text = month_start.strftime(\"%Y-%m-%d\")\n",
    "        end_text = month_end.strftime(\"%Y-%m-%d\")\n",
    "\n",
    "        print(f\"Downloading {timespan}: {start_text} to {end_text}\")\n",
    "\n",
    "        url = (\n",
    "            f\"{BASE_URL}/v2/aggs/ticker/SPY/range/\"\n",
    "            f\"1/{timespan}/{start_text}/{end_text}\"\n",
    "        )\n",
    "\n",
    "        rows = fetch_pages(url, {\n",
    "            \"adjusted\": \"false\",\n",
    "            \"sort\": \"asc\",\n",
    "            \"limit\": 50000,\n",
    "        })\n",
    "\n",
    "        if not rows:\n",
    "            raise RuntimeError(f\"No {timespan} data for {start_text}.\")\n",
    "\n",
    "        all_rows.extend(rows)\n",
    "\n",
    "    prices = pd.DataFrame(all_rows)\n",
    "\n",
    "    prices[\"timestamp\"] = (\n",
    "        pd.to_datetime(prices[\"t\"], unit=\"ms\", utc=True)\n",
    "        .dt.tz_convert(\"America/New_York\")\n",
    "    )\n",
    "\n",
    "    prices = prices.rename(columns={\n",
    "        \"o\": \"open\",\n",
    "        \"h\": \"high\",\n",
    "        \"l\": \"low\",\n",
    "        \"c\": \"close\",\n",
    "        \"v\": \"volume\",\n",
    "    })\n",
    "\n",
    "    prices = (\n",
    "        prices.set_index(\"timestamp\")\n",
    "        .sort_index()\n",
    "    )\n",
    "\n",
    "    prices = prices[~prices.index.duplicated(keep=\"last\")]\n",
    "\n",
    "    if timespan == \"minute\":\n",
    "        prices = prices.between_time(\n",
    "            \"09:30\", \"16:00\", inclusive=\"left\"\n",
    "        )\n",
    "\n",
    "    return prices[[\"open\", \"high\", \"low\", \"close\", \"volume\"]]\n",
    "\n",
    "\n",
    "if NEED_DOWNLOAD:\n",
    "    # 1. Minute prices\n",
    "    minute_data = download_prices(\"minute\")\n",
    "    minute_data.to_csv(\"data/SPY_1min.csv\")\n",
    "    \n",
    "    # 2. Daily prices\n",
    "    daily_data = download_prices(\"day\")\n",
    "    daily_data.to_csv(\"data/SPY_daily.csv\")\n",
    "    \n",
    "    # 3. Dividends\n",
    "    dividend_rows = fetch_pages(\n",
    "        f\"{BASE_URL}/v3/reference/dividends\",\n",
    "        {\n",
    "            \"ticker\": \"SPY\",\n",
    "            \"ex_dividend_date.gte\": START,\n",
    "            \"ex_dividend_date.lte\": END,\n",
    "            \"limit\": 1000,\n",
    "        },\n",
    "    )\n",
    "    \n",
    "    if not dividend_rows:\n",
    "        raise RuntimeError(\"No dividends returned; investigate before proceeding.\")\n",
    "    \n",
    "    dividend_data = pd.DataFrame(dividend_rows)\n",
    "    dividend_data = (\n",
    "        dividend_data[[\"ex_dividend_date\", \"cash_amount\"]]\n",
    "        .rename(columns={\"cash_amount\": \"dividend\"})\n",
    "        .drop_duplicates()\n",
    "        .sort_values(\"ex_dividend_date\")\n",
    "    )\n",
    "    \n",
    "    dividend_data.to_csv(\"data/SPY_dividends.csv\", index=False)\n",
    "    \n",
    "    print(\"\\nDownload complete!\")\n",
    "    print(\"Minute rows:\", len(minute_data))\n",
    "    print(\"Daily rows:\", len(daily_data))\n",
    "    print(\"Dividend records:\", len(dividend_data))\n",
    "else:\n",
    "    print(\"Reusing existing raw data CSVs. No API request made.\")\n"
   ]
  },
