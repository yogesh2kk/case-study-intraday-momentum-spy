    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "Path(\"results\").mkdir(exist_ok=True)\n",
    "\n",
    "# Load the indicators we created earlier.\n",
    "prices = pd.read_csv(\"data/SPY_indicators.csv\")\n",
    "\n",
    "prices[\"timestamp\"] = (\n",
    "    pd.to_datetime(prices[\"timestamp\"], utc=True)\n",
    "    .dt.tz_convert(\"America/New_York\")\n",
    ")\n",
    "prices[\"date\"] = prices[\"timestamp\"].dt.date\n",
    "prices = prices.sort_values(\"timestamp\")\n",
    "\n",
    "# Only use sessions with complete indicators.\n",
    "required = [\"upper_band\", \"lower_band\", \"vwap\"]\n",
    "\n",
    "valid_dates = [\n",
    "    date\n",
    "    for date, group in prices.groupby(\"date\")\n",
    "    if len(group) == 390\n",
    "    and group[required].notna().all().all()\n",
    "]\n",
    "\n",
    "prices = prices[prices[\"date\"].isin(valid_dates)].copy()\n",
    "\n",
    "# Split by complete trading days, in chronological order.\n",
    "dates = sorted(prices[\"date\"].unique())\n",
    "\n",
    "if len(dates) < 30:\n",
    "    raise ValueError(\"Too few eligible sessions. Check the full download.\")\n",
    "\n",
    "split_position = int(len(dates) * 0.70)\n",
    "\n",
    "train_dates = dates[:split_position]\n",
    "test_dates = dates[split_position:]\n",
    "\n",
    "train_prices = prices[prices[\"date\"].isin(train_dates)].copy()\n",
    "test_prices = prices[prices[\"date\"].isin(test_dates)].copy()\n",
    "\n",
    "print(\"Development:\", train_dates[0], \"to\", train_dates[-1])\n",
    "print(\"Final test:\", test_dates[0], \"to\", test_dates[-1])"
